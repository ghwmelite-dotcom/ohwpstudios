---
export const prerender = false;
import StudioLayout from '@/layouts/StudioLayout.astro';
import { selectedWork } from '@/data/selected-work';
import { getPublicProject, publicUrl, type PublicProject } from '@/lib/public-portfolio';
const { slug = '' } = Astro.params;
const curated = selectedWork.find(project => project.slug === slug);
let stored: PublicProject | null = null;
if (!curated) {
  try { const db = Astro.locals.runtime?.env?.DB; if (db) stored = await getPublicProject(db, slug); }
  catch { console.error('Published project read unavailable'); }
}
if (!curated && !stored) return Astro.redirect('/404');
const title = curated?.title ?? stored?.title ?? '';
const description = curated?.description ?? stored?.subtitle ?? stored?.description ?? '';
const image = publicUrl(curated?.image ?? stored?.featured_image);
const liveUrl = publicUrl(curated?.url ?? stored?.project_url);
const challenge = curated?.challenge ?? stored?.challenge;
const solution = curated?.solution ?? stored?.solution;
---
<StudioLayout title={`${title} — OhWP Studios`} description={description}>
  <main id="main" class="wrap">
    <div class="case-hero"><a class="text-link" href="/portfolio">Back to all work</a><p class="section-label">{curated ? `${curated.category} · ${curated.kind}` : stored?.category_name || 'Published project'}</p><h1>{title}</h1><p>{description}</p>
      {curated && <div class="case-tags">{curated.capabilities.map(label => <span>{label}</span>)}</div>}
    </div>
    {image && <img class="case-image" src={image} alt={`${title} screenshot`} width="1250" height="714" />}
    <div class="case-content">{challenge && <div><h2>The idea</h2><p>{challenge}</p></div>}{solution && <div><h2>The approach</h2><p>{solution}</p></div>}</div>
    <div class="case-links">{liveUrl && <a class="button" href={liveUrl} target="_blank" rel="noopener noreferrer">Explore the product <span aria-hidden="true">↗</span></a>}{curated && <a class="text-link" href={curated.repository} target="_blank" rel="noopener noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>}<a class="text-link" href="/#contact">Build something with us</a></div>
  </main>
</StudioLayout>
