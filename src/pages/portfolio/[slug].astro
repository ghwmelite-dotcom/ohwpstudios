---
export const prerender = false;
import StudioLayout from '@/layouts/StudioLayout.astro';
import { portfolioDetail } from '@/lib/portfolio-presentation';
const { slug = '' } = Astro.params;
const project=await portfolioDetail(Astro.locals.runtime?.env?.DB,slug);
if(!project){Astro.response.status=404;return Astro.rewrite('/404');}
const curated=project;
const title=project.title,description=project.description,image=project.image,liveUrl=project.url,challenge=project.challenge,solution=project.solution;

---
<StudioLayout title={`${title} — OhWP Studios`} description={description}>
  <main id="main" class="wrap">
    <div class="case-hero"><a class="text-link" href="/portfolio">Back to all work</a><p class="section-label">{`${project.category} · ${project.kind}`} </p><h1>{title}</h1><p>{description}</p>
      {curated && <div class="case-tags">{curated.capabilities.map(label => <span>{label}</span>)}</div>}
    </div>
    {image && <img class="case-image" src={image} alt={`${title} ${project.illustration?'conceptual project illustration':'project image'}`} width="1250" height="714" />}
    <div class="case-content">{challenge && <div><h2>The idea</h2><p>{challenge}</p></div>}{solution && <div><h2>The approach</h2><p>{solution}</p></div>}{project.results&&<div><h2>Project notes</h2><p>{project.results}</p></div>}</div>
    <div class="case-links">{liveUrl && <a class="button" href={liveUrl} target="_blank" rel="noopener noreferrer">Visit the project <span aria-hidden="true">↗</span></a>}{project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>}<a class="text-link" href="/#contact">Build something with us</a></div>
  </main>
</StudioLayout>
