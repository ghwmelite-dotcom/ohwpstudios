---
export const prerender = false;
import StudioLayout from '@/layouts/StudioLayout.astro';
import StudioSeal from '@/components/StudioSeal.astro';
import SelectedWork from '@/components/SelectedWork.astro';
import { portfolioPresentation } from '@/lib/portfolio-presentation';
const projects = await portfolioPresentation(Astro.locals.runtime?.env?.DB);
const featured=projects.filter(project=>project.featured).slice(0,3);
const additional=projects.filter(project=>!featured.some(item=>item.slug===project.slug));
---
<StudioLayout interior title="Our work — Hodges & Co. Studios" description="Explore software, AI, and digital products built by Hodges & Co. Studios. Project context, live experiences, and public source code.">
  <main id="main" class="portfolio-page">
    <section class="portfolio-stage"><div class="wrap portfolio-stage-grid"><div><p class="section-label">The work speaks.</p><h1>Ideas,<br/>made real.</h1><p class="portfolio-lede">Different challenges. The same care in the craft. Explore the products, the thinking, and the code behind our work.</p><a class="portfolio-jump" href="#collection">Explore the collection <span aria-hidden="true">↓</span></a></div><StudioSeal /></div><div class="wrap portfolio-stage-foot"><span>Software / AI / Digital products</span><span>Built in Accra. Working everywhere.</span></div></section>
    <div class="wrap portfolio-collection" id="collection"><SelectedWork full projects={featured} />
      {additional.length > 0 && <><div class="collection-heading"><h2>More ways we build.</h2><p>Purpose-built platforms, practical tools and experiments in what comes next.</p></div><div class="studio-project-grid">{additional.map(project => <article class="studio-project-card"><a class="studio-project-image" href={`/portfolio/${encodeURIComponent(project.slug)}`}>{project.image&&<img src={project.image} alt={`${project.title} ${project.illustration?'conceptual illustration':'project image'}`} width="1200" height="750" loading="lazy"/>}<span>{project.illustration?'Project illustration':project.kind}</span></a><div class="studio-project-copy"><p class="project-discipline">{project.category}</p><h3><a href={`/portfolio/${encodeURIComponent(project.slug)}`}>{project.title}</a></h3><p>{project.description}</p><div class="project-stack">{project.capabilities.slice(0,3).map(capability=><span>{capability}</span>)}</div><a class="project-read" href={`/portfolio/${encodeURIComponent(project.slug)}`}>Explore the project <span aria-hidden="true">↗</span></a></div></article>)}</div></>}

    </div>
  </main>
</StudioLayout>

<style>
.collection-heading{margin:80px 0 32px;display:flex;justify-content:space-between;align-items:end;gap:32px}.collection-heading h2{font-family:var(--font-display);font-size:clamp(36px,4vw,56px);line-height:1.1;letter-spacing:-.04em;margin:0}.collection-heading p{font-size:15px;line-height:1.7;max-width:360px;color:var(--color-text-secondary)}.studio-project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.studio-project-card{overflow:hidden;border:1px solid var(--color-border);border-radius:20px;background:var(--color-surface);box-shadow:0 8px 28px #15213c05}.studio-project-image{display:block;position:relative;background:#0b1025;overflow:hidden;aspect-ratio:16/10}.studio-project-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}.studio-project-image:hover img{transform:scale(1.025)}.studio-project-image>span{position:absolute;bottom:16px;left:20px;background:#0b1025d9;border:1px solid #e7c99755;color:#f8f1e5;border-radius:100px;font-size:11px;padding:6px 12px}.studio-project-copy{padding:32px}.project-discipline{font-size:12px;color:var(--color-text-secondary);margin:0 0 14px}.studio-project-copy h3{font-family:var(--font-display);font-size:32px;letter-spacing:-.035em;margin:0 0 16px}.studio-project-copy>p:not(.project-discipline){font-size:15px;line-height:1.8;color:var(--color-text-secondary);max-width:60ch}.project-stack{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.project-stack span{font-size:11px;padding:6px 10px;border:1px solid var(--color-border);border-radius:100px}.project-read{display:flex;align-items:center;justify-content:space-between;padding-top:20px;border-top:1px solid var(--color-border);font-size:13px;font-weight:600}.project-read span{font-size:21px}@media(max-width:720px){.studio-project-grid{grid-template-columns:1fr}.collection-heading{display:block}.studio-project-copy{padding:24px}}@media(prefers-reduced-motion:reduce){.studio-project-image img{transition:none}}
</style>
