---
export const prerender = false;
import { getStudioClients, type StudioClient } from '@/lib/public-studio';
import { publicUrl } from '@/lib/public-portfolio';
let clients: StudioClient[] = [];
let unavailable = false;
try { const db = Astro.locals.runtime?.env?.DB; if(db) clients=await getStudioClients(db); else unavailable=true; } catch { unavailable=true; }
import InteriorLayout from '@/layouts/InteriorLayout.astro';
---
<InteriorLayout title="Working together — OhWP Studios" description="A thoughtful partnership from first idea through build, review, and handover. Work with OhWP Studios on your next software project."><main id="main"><section class="interior-mast"><div class="wrap"><p class="eyebrow">Working together</p><h1>A partner in the idea.<br /><em>Care in the execution.</em></h1><p class="lede">Whether you’re an independent founder, a growing organisation, or a team modernising its work, we start by understanding what matters to you.</p><div class="mast-foot"><span>Clear scope / Shared progress / Considered delivery</span><a href="/contact">Start a conversation ↗</a></div></div></section><section class="wrap section-space"><p class="eyebrow">Client partnerships</p>{unavailable ? <p>Client details are temporarily unavailable. Please try again shortly.</p> : clients.length ? <div class="cms-clients">{clients.map(client=><article class="cms-client">{publicUrl(client.logo_url) && <img src={publicUrl(client.logo_url)} alt={client.name} loading="lazy" />}<h3>{client.name}</h3>{client.industry && <p>{client.industry}</p>}{client.description && <p>{client.description}</p>}{client.project_type && <p>{client.project_type}</p>}{publicUrl(client.website_url) && <a class="text-link" href={publicUrl(client.website_url)} target="_blank" rel="noopener noreferrer">Visit website ↗</a>}</article>)}</div> : <p>New client profiles will appear here when published by the studio.</p>}</section><section class="wrap section-space principle-grid"><article><span class="index">01 / Understand</span><h3>Your context comes first.</h3><p>People, workflows, budget, and the outcome you need. We agree a practical scope before building.</p></article><article><span class="index">02 / Collaborate</span><h3>See the work take shape.</h3><p>Working previews and clear decisions throughout. Commission the build, or take part with guided support.</p></article><article><span class="index">03 / Own</span><h3>Leave with clarity.</h3><p>Agree the handover, documentation, ownership, and support you need as part of the project.</p></article></section><section class="interior-band"><div class="wrap"><h2>Get to know<br />the way we build.</h2><a class="button" href="/portfolio">Explore the work ↗</a></div></section></main></InteriorLayout>
