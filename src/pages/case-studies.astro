---
export const prerender = false;
import { getStudioCases, type StudioCase } from '@/lib/public-studio';
import { publicUrl } from '@/lib/public-portfolio';
let cases: StudioCase[] = [];
let unavailable = false;
try { const db=Astro.locals.runtime?.env?.DB; if(db) cases=await getStudioCases(db); else unavailable=true; } catch { unavailable=true; }
const industries=[...new Set(cases.map(item=>item.industry).filter(Boolean))];
function metrics(value:string|null):[string,string][] { try { const data=JSON.parse(value||'{}'); return Object.entries(data).filter(([,v])=>typeof v==='string'||typeof v==='number').map(([k,v])=>[k,String(v)]); } catch { return []; } }
import InteriorLayout from '@/layouts/InteriorLayout.astro';
import SelectedWork from '@/components/SelectedWork.astro';
---
<InteriorLayout title="Inside the work — OhWP Studios" description="Explore working studio products and the ideas behind them. Practical software, designed and engineered by OhWP Studios."><main id="main"><section class="interior-mast"><div class="wrap"><p class="eyebrow">Inside the work</p><h1>From a real problem<br /><em>to a working product.</em></h1><p class="lede">A closer look at our studio’s own products. Explore the live experiences and the thinking behind what we make.</p><div class="mast-foot"><span>Studio projects</span><a href="/portfolio">Explore all published work ↗</a></div></div></section><section class="wrap section-space"><p class="eyebrow">Published case studies</p>{unavailable && <p>Case studies are temporarily unavailable. Please try again shortly.</p>}{cases.length > 0 && <><div class="case-filters" aria-label="Filter case studies by industry"><button type="button" data-industry="all" aria-pressed="true">All industries</button>{industries.map(industry=><button type="button" data-industry={industry} aria-pressed="false">{industry}</button>)}</div>{cases.map(item=><article class="cms-case" data-case-industry={item.industry}><p class="eyebrow">{item.client_name} · {item.industry}</p><h2>{item.title}</h2>{publicUrl(item.image_url) && <img src={publicUrl(item.image_url)} alt="" loading="lazy" />}<dl>{[['The challenge',item.challenge],['The solution',item.solution],['The result',item.results],['Technology',item.tech_stack],['Duration',item.project_duration],['Team',item.team_size ? String(item.team_size) : null],...metrics(item.metrics)].map(([label,value])=>value && <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>{item.testimonial && <blockquote><p>{item.testimonial}</p><cite>{item.testimonial_author} {item.testimonial_role}</cite></blockquote>}</article>)}</>}{!unavailable && cases.length===0 && <p>Client case studies will appear here as they are published. Explore our studio products below.</p>}</section><section class="wrap section-space"><p class="eyebrow">Studio products / Built by OhWP</p><SelectedWork /></section><section class="interior-band"><div class="wrap"><h2>Something here<br />spark an idea?</h2><a class="button" href="/contact">Let’s build on it ↗</a></div></section></main></InteriorLayout>

<script>
 document.querySelectorAll<HTMLButtonElement>('[data-industry]').forEach(button=>button.addEventListener('click',()=>{
  document.querySelectorAll<HTMLButtonElement>('[data-industry]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
  document.querySelectorAll<HTMLElement>('[data-case-industry]').forEach(item=>{item.hidden=button.dataset.industry!=='all' && item.dataset.caseIndustry!==button.dataset.industry;});
 }));
</script>
