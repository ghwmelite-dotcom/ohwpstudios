---
import { CONSENT_KEY, CONSENT_GRANTED } from "@/lib/analytics";
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const cfBeaconConfig = CF_BEACON_TOKEN ? JSON.stringify({token:CF_BEACON_TOKEN}) : undefined;
---
    <!-- Analytics: CF Web Analytics beacon (no cookies, no consent needed) -->
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={cfBeaconConfig}
      ></script>
    )}
    <!-- Analytics: GA4 with Consent Mode v2 defaults (deny-by-default until banner accept) -->
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID, CONSENT_KEY, CONSENT_GRANTED }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        try {
          if (localStorage.getItem(CONSENT_KEY) === CONSENT_GRANTED) {
            gtag('consent', 'update', { analytics_storage: 'granted' });
          }
        } catch (e) { /* private mode etc. — stay denied */ }
        gtag('js', new Date());
        gtag('config', GA_ID);
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(gaScript);
      </script>
    )}

