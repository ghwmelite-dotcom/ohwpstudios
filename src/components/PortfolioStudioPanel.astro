---
import BrandMark from './BrandMark.astro';
import PortfolioSyncPanel from './PortfolioSyncPanel.astro';
---
<section class="portfolio-workspace">
  <header class="portfolio-intro"><div class="portfolio-seal"><BrandMark size={48}/></div><div><p>Your project collection</p><h2>Proof of the craft.</h2><p>Give each project its own story. Show the thinking, the product and the code.</p></div><a href="/admin/portfolio?new=1" class="collection-add">Add a project <span aria-hidden="true">+</span></a></header>
  <div class="repository-invitation"><div><h3>From your repositories to your portfolio.</h3><p>Eight considered project studies, curated from public GitHub repositories. New entries arrive as drafts; the three already-public featured projects retain their approved copy. Existing records are never overwritten.</p><a href="/admin/portfolio">Open the complete project manager <span aria-hidden="true">↗</span></a></div><button id="import-repository-projects" type="button">Import curated projects <span aria-hidden="true">↗</span></button></div>
  <PortfolioSyncPanel/>
  <p id="portfolio-collection-status" role="status" aria-live="polite">Loading your project collection…</p>
  <nav class="collection-filters" aria-label="Project publication filter"><button type="button" data-project-filter="all" aria-pressed="true">All projects</button><button type="button" data-project-filter="published" aria-pressed="false">Published</button><button type="button" data-project-filter="draft" aria-pressed="false">Drafts</button></nav>
  <div id="portfolio-collection" class="collection-grid"></div>
</section>
<style>
.portfolio-workspace{--collection-ink:#18243d;--collection-blue:#273d83;--collection-gold:#ddc18c;--collection-paper:#fffdf8;--collection-line:#dce1eb;--collection-muted:#626e85;min-width:0}.portfolio-intro{display:flex;align-items:center;gap:24px;border-radius:22px;padding:36px;background:linear-gradient(125deg,#0b1025,#202e58);color:#f8f1e5;margin-bottom:24px;position:relative;overflow:hidden}.portfolio-seal{flex-shrink:0;color:var(--collection-gold);border:1px solid #ddc18c55;border-radius:50%;width:88px;height:88px;display:grid;place-items:center}.portfolio-seal :global(svg){width:48px;height:48px}.portfolio-intro h2{color:#f8f1e5!important;font-family:var(--font-display);font-size:clamp(34px,4vw,48px);letter-spacing:-.045em;font-weight:450;line-height:1.15;margin:8px 0 12px}.portfolio-intro p{font-size:13px;color:#d3daef;line-height:1.75;margin:0;max-width:500px}.portfolio-workspace .collection-add{margin-left:auto;white-space:nowrap;display:flex;gap:20px;align-items:center;min-height:48px;padding:12px 20px;border:1px solid #ddc18c70;border-radius:12px;color:var(--collection-gold);font-size:13px;font-weight:600}.collection-add span{font-size:22px}.repository-invitation{display:flex;align-items:center;gap:32px;padding:28px 32px;border:1px solid var(--collection-line);border-radius:20px;background:var(--collection-paper);margin-bottom:24px}.repository-invitation h3{font-family:var(--font-display);font-size:25px;letter-spacing:-.03em;font-weight:500;margin:0 0 12px}.repository-invitation p{font-size:14px;line-height:1.8;color:var(--collection-muted);max-width:70ch;margin:0 0 16px}.portfolio-workspace .repository-invitation a{font-size:13px;font-weight:600;color:var(--collection-blue);text-decoration:underline;text-underline-offset:5px}.repository-invitation button{flex-shrink:0;display:flex;gap:20px;align-items:center;min-height:48px;padding:16px 20px;border:0;border-radius:12px;background:var(--collection-blue);color:white;font:600 13px var(--font-body,Arial,sans-serif);cursor:pointer}.repository-invitation button:disabled{opacity:.6;cursor:progress}#portfolio-collection-status{font-size:13px;color:var(--collection-muted);line-height:1.7;margin:16px 0}.collection-filters{display:flex;gap:8px;margin:24px 0;flex-wrap:wrap}.collection-filters button{font:500 13px var(--font-body,Arial,sans-serif);min-height:44px;padding:10px 18px;border:1px solid var(--collection-line);border-radius:100px;color:var(--collection-ink);background:var(--collection-paper);cursor:pointer}.collection-filters button[aria-pressed=true]{background:var(--collection-ink);border-color:var(--collection-ink);color:white}.collection-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;min-width:0}.collection-grid :global(.collection-card){border:1px solid var(--collection-line);border-radius:20px;background:var(--collection-paper);overflow:hidden;min-width:0;box-shadow:0 8px 24px #18243d05}.collection-grid :global(.collection-cover){display:block;width:100%;aspect-ratio:16/10;object-fit:cover;background:#111b39;border:0}.collection-grid :global(.collection-card-copy){padding:24px}.collection-grid :global(.collection-meta){display:flex;gap:12px;justify-content:space-between;align-items:center;font-size:11px;color:var(--collection-muted);margin-bottom:16px}.collection-grid :global(.collection-state){border:1px solid var(--collection-line);border-radius:100px;padding:4px 9px;color:var(--collection-blue)}.collection-grid :global(h3){font-family:var(--font-display);font-size:28px;line-height:1.2;letter-spacing:-.035em;margin:0 0 12px;font-weight:500;color:var(--collection-ink)}.collection-grid :global(.collection-description){font-size:14px;line-height:1.75;color:var(--collection-muted);margin:0 0 24px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.collection-grid :global(.collection-card-links){display:flex;align-items:center;gap:20px;flex-wrap:wrap;border-top:1px solid var(--collection-line);padding-top:18px}.portfolio-workspace .collection-grid :global(a){font-size:12px;color:var(--collection-blue);font-weight:600;min-height:36px;display:inline-flex;align-items:center;text-decoration:underline;text-underline-offset:4px}.collection-grid :global(.collection-empty){grid-column:1/-1;min-height:200px;padding:40px;border:1px dashed var(--collection-line);border-radius:20px;display:grid;place-content:center;text-align:center;background:var(--collection-paper)}.collection-grid :global(.collection-empty p){font-size:14px;line-height:1.8;color:var(--collection-muted);max-width:55ch}.portfolio-workspace :is(a,button):focus-visible{outline:2px solid var(--collection-blue);outline-offset:4px}@media(max-width:1050px){.portfolio-intro{align-items:flex-start;flex-wrap:wrap}.portfolio-workspace .collection-add{margin-left:112px}.repository-invitation{flex-direction:column;align-items:flex-start}}@media(max-width:700px){.portfolio-intro{padding:24px;gap:18px}.portfolio-seal{width:64px;height:64px}.portfolio-intro h2{font-size:34px}.portfolio-workspace .collection-add{margin-left:0}.repository-invitation{padding:24px}.collection-grid{grid-template-columns:1fr}.portfolio-intro>div:nth-child(2){flex:1;min-width:180px}}
</style>
