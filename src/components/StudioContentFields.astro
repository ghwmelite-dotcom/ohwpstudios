---
import { STUDIO_FIELDS, type StudioSection } from '@/lib/studio-content';
import BrandMark from './BrandMark.astro';
interface Props { section:StudioSection }
const {section}=Astro.props;
const config={
  home:{title:'Shape the first impression.',intro:'A clear story, from your opening line to the next conversation.',link:'/',groups:[{name:'The opening',note:'Give your ambition a voice.',keys:['studio_hero_eyebrow','studio_hero_title','studio_hero_intro','studio_hero_choice']},{name:'The studio',note:'The people and perspective behind the work.',keys:['studio_story_title','studio_story_intro','studio_story_context']},{name:'The invitation',note:'Make the next step feel natural.',keys:['studio_contact_title','studio_contact_intro']}]},
  services:{title:'Make the possibilities clear.',intro:'Three connected disciplines. One invitation to build something useful.',link:'/#services',groups:[{name:'The introduction',note:'Connect your capabilities to the client’s ambition.',keys:['studio_services_intro']},{name:'Software & platforms',note:'Products built around the people who use them.',keys:['studio_software_title','studio_software_copy']},{name:'AI & automation',note:'Intelligence with a practical purpose.',keys:['studio_ai_title','studio_ai_copy']},{name:'Trading technology',note:'Clear rules, thoughtful engineering and responsible testing.',keys:['studio_trading_title','studio_trading_copy']},{name:'Build together',note:'A place for clients who want to learn the craft.',keys:['studio_guided_copy']}]},
  about:{title:'Tell the studio’s story.',intro:'Your perspective, your roots and the care behind the work.',link:'/about',groups:[{name:'The introduction',note:'Set the tone for a closer look.',keys:['studio_about_badge','studio_about_title','studio_about_description']},{name:'The story',note:'Separate paragraphs with a blank line.',keys:['studio_about_story_title','studio_about_story_content']}]},
  footer:{title:'Leave a lasting invitation.',intro:'The final words should feel as considered as the first.',link:'/#contact',groups:[{name:'The closing note',note:'Shared across the studio website.',keys:['studio_footer_kicker','studio_footer_title']}]},
}[section];
const fields=STUDIO_FIELDS.filter(field=>field.section===section);
---
<section class="content-workspace" data-content-workspace={section}>
  <header class="workspace-intro"><div><p class="workspace-context">Studio content / {section==='home'?'Homepage':section==='services'?'Services':section==='about'?'About':'Footer'}</p><h2>{config.title}</h2><p>{config.intro}</p></div><a href={config.link} target="_blank" rel="noopener noreferrer">Open saved page <span aria-hidden="true">↗</span></a></header>
  <div class="workspace-grid"><div class="editor-groups">
    {config.groups.map(group=><section class="copy-group"><header><h3>{group.name}</h3><p>{group.note}</p></header><div class="copy-fields">{group.keys.map(key=>{const field=fields.find(item=>item.key===key)!;return <div class="copy-field"><div class="copy-label"><label for={key}>{field.label.replace(' — use a line break between phrases','')}</label><span data-count-for={key} aria-hidden="true">{field.value.length} characters</span></div><textarea id={key} rows={key.includes('story_content')?9:key.includes('title')?3:4} maxlength="10000" data-studio-content aria-describedby={`${key}-hint`}>{field.value}</textarea><small id={`${key}-hint`}>{key.includes('title')?'A line break gives each phrase room to breathe.':key.includes('story_content')?'Use a blank line between paragraphs.':'Plain text, written for the people you want to reach.'}</small></div>})}</div></section>)}
  </div><aside class="copy-preview"><div class="preview-heading"><span>Preview of your copy</span><span class="preview-dot" aria-hidden="true"></span></div><div class="preview-canvas"><BrandMark size={40}/><p data-preview-eyebrow></p><h3 data-preview-title></h3><p class="preview-description" data-preview-description></p><p class="preview-choice" data-preview-choice></p><div class="preview-rule"></div><span class="preview-signature">Hodges &amp; Co. Studios</span></div><p class="preview-caption">An immediate view of your words. Save Changes above to update the site.</p><div class="editor-note"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"/></svg><p>Keep it human. A specific promise says more than a long list of capabilities.</p></div></aside></div>
</section>
<script>
  function updateCopyPreviews(){
    document.querySelectorAll<HTMLElement>('[data-content-workspace]').forEach(workspace=>{
      const section=workspace.dataset.contentWorkspace;
      const discipline=workspace.getAttribute('data-preview-discipline')||'software';
      const ids=section==='home'?['studio_hero_eyebrow','studio_hero_title','studio_hero_intro','studio_hero_choice']:section==='services'?['studio_services_intro',`studio_${discipline}_title`,`studio_${discipline}_copy`,'studio_guided_copy']:section==='about'?['studio_about_badge','studio_about_title','studio_about_description','studio_about_story_title']:['studio_footer_kicker','studio_footer_title','',''];
      ['eyebrow','title','description','choice'].forEach((part,index)=>{const target=workspace.querySelector(`[data-preview-${part}]`);const field=document.getElementById(ids[index]) as HTMLTextAreaElement|null;if(target)target.textContent=field?.value||'';});
      workspace.querySelectorAll<HTMLTextAreaElement>('[data-studio-content]').forEach(field=>{const count=workspace.querySelector(`[data-count-for="${field.id}"]`);if(count)count.textContent=`${field.value.length} characters`;});
    });
  }
  document.addEventListener('focusin',event=>{if(event.target instanceof HTMLTextAreaElement){const match=event.target.id.match(/^studio_(software|ai|trading)_/);if(match){event.target.closest('[data-content-workspace]')?.setAttribute('data-preview-discipline',match[1]);updateCopyPreviews();}}});
  document.addEventListener('input',event=>{if(event.target instanceof HTMLTextAreaElement&&event.target.hasAttribute('data-studio-content'))updateCopyPreviews();});
  document.addEventListener('studio-content-loaded',updateCopyPreviews);
  updateCopyPreviews();
</script>
<style>
  .content-workspace{--editor-ink:#18243d;--editor-blue:#273d83;--editor-gold:#ddc18c;--editor-paper:#fffdf8;--editor-line:#dce1eb;--editor-muted:#626e85;min-width:0;color:var(--editor-ink);margin-bottom:40px}
  .workspace-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px}.workspace-context{font-size:13px;color:var(--editor-muted);margin:0 0 12px}.workspace-intro h2{font-family:var(--font-display);font-size:clamp(30px,3vw,42px);font-weight:450;letter-spacing:-.04em;line-height:1.15;margin:0 0 12px}.workspace-intro p:last-child{font-size:15px;color:var(--editor-muted);line-height:1.7;max-width:580px;margin:0}.workspace-intro a{color:var(--editor-blue);font-size:14px;font-weight:600;display:flex;gap:16px;align-items:center;white-space:nowrap;min-height:44px;text-decoration:underline;text-underline-offset:5px}
  .workspace-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:28px;align-items:start}.editor-groups{display:grid;gap:24px;min-width:0}.copy-group{border:1px solid var(--editor-line);border-radius:20px;background:var(--editor-paper);padding:28px;box-shadow:0 6px 24px #18243d04;min-width:0}.copy-group>header{padding-bottom:22px;margin-bottom:24px;border-bottom:1px solid var(--editor-line)}.copy-group h3{font-family:var(--font-display);font-size:26px;font-weight:500;letter-spacing:-.03em;margin:0 0 6px}.copy-group header p{color:var(--editor-muted);font-size:14px;line-height:1.6;margin:0}.copy-fields{display:grid;gap:24px}.copy-field{min-width:0}.copy-label{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:10px}.copy-label label{display:block;font-size:14px;font-weight:600;line-height:1.5;color:var(--editor-ink)}.copy-label>span{font-size:11px;color:var(--editor-muted);white-space:nowrap}.copy-field textarea{display:block;width:100%;box-sizing:border-box;min-height:104px;padding:16px 18px;border:1px solid var(--editor-line);border-radius:12px;background:#f8f9fc;color:var(--editor-ink);font:400 16px/1.65 var(--font-body,Arial,sans-serif);resize:vertical;transition:border-color .2s ease,box-shadow .2s ease}.copy-field textarea:focus{outline:2px solid var(--editor-blue);outline-offset:3px;border-color:var(--editor-blue);box-shadow:0 0 0 5px #273d830a;background:white}.copy-field small{display:block;font-size:12px;color:var(--editor-muted);line-height:1.6;margin-top:8px}
  .copy-preview{position:sticky;top:130px;min-width:0}.preview-heading{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--editor-muted);margin:0 0 16px;padding:0 4px}.preview-dot{width:7px;height:7px;border-radius:50%;background:var(--editor-gold);box-shadow:0 0 0 5px #ddc18c22}.preview-canvas{background:radial-gradient(ellipse at 100% 0,#29376c80,transparent 75%),#0b1025;color:#f8f1e5;border:1px solid #354064;border-radius:20px;padding:28px;overflow:hidden;box-shadow:0 16px 32px #111b3920}.preview-canvas :global(svg){color:var(--editor-gold);width:40px;height:40px;margin-bottom:36px}.preview-canvas>p:first-of-type{font-size:11px;line-height:1.65;color:#d6dcf0;white-space:pre-line}.preview-canvas h3{color:#f8f1e5!important;font-family:var(--font-display);font-size:32px;font-weight:450;letter-spacing:-.045em;line-height:1.12;white-space:pre-line;overflow-wrap:anywhere;margin:22px 0}.preview-description{font-size:13px;line-height:1.8;color:#d6dcf0;white-space:pre-line}.preview-choice{font-size:12px;line-height:1.7;color:var(--editor-gold);margin-top:24px}.preview-rule{height:1px;background:#ddc18c35;margin:32px 0 16px}.preview-signature{font-family:var(--font-display);font-size:17px}.preview-caption{font-size:12px;color:var(--editor-muted);line-height:1.75;margin:16px 4px}.editor-note{display:flex;gap:12px;padding:20px 4px;border-top:1px solid var(--editor-line);color:var(--editor-muted);font-size:13px;line-height:1.7}.editor-note span{color:var(--editor-blue);font-size:20px}.editor-note p{margin:0}
  @media(max-width:1180px){.workspace-grid{grid-template-columns:minmax(0,1fr)}.copy-preview{position:static;display:none}}@media(max-width:640px){.workspace-intro{align-items:flex-start;flex-direction:column;gap:12px}.copy-group{padding:20px}.copy-label{align-items:flex-start;flex-direction:column;gap:4px}.copy-field textarea{padding:14px;min-height:120px}.workspace-intro h2{font-size:32px}}
  @media(prefers-reduced-motion:reduce){.copy-field textarea{transition:none}}
</style>
