---
import '@fontsource-variable/fraunces/wght.css';
import '@/styles/studio.css';
import '@/styles/premium.css';
import '@/styles/studio-features.css';
import StudioNavigation from '@/components/StudioNavigation.astro';
import NewsletterSubscribe from '@/components/NewsletterSubscribe.astro';
import Chatbot from '@/components/Chatbot.astro';
import SiteAnalytics from '@/components/SiteAnalytics.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import AdinkraIcon from '@/components/AdinkraIcon.astro';
import { SITE_CONFIG } from '@/config';
interface Props { title?: string; description?: string; home?: boolean; interior?: boolean; noindex?: boolean; image?: string; article?: { publishedTime?: string; modifiedTime?: string; author?: string; section?: string; tags?: string[] } }
const { title = 'OhWP Studios — From idea to working software', description = 'Custom software, AI automation, trading systems, and hands-on guidance with Codex and Claude Code. Built for you, or built together. Accra, Ghana.', home = false, interior = false, noindex = false, image = '/og-image.jpg', article } = Astro.props;
const isPreview = import.meta.env.DEV || Astro.url.hostname !== 'ohwpstudios.org';
const canonical = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1B5E3A" />
    <link rel="manifest" href="/manifest.json" />
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'; } catch {}</script>
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE_CONFIG.url).href} />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map(tag => <meta property="article:tag" content={tag} />)}
    <SiteAnalytics />
    <slot name="head" />
  </head>
  <body class:list={{ 'premium-home': home, 'premium-interior': interior }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="header-shell"><header class="studio-header wrap">
      <a class="wordmark" href="/" aria-label="OhWP Studios home"><AdinkraIcon symbol="nkyinkyim" size={32} />OhWP<span>Studios</span></a>
      <StudioNavigation />
      <a class="button button-small" href="/estimate-project">Scope my project <span aria-hidden="true">↗</span></a>
    </header></div>
    <slot />
    <footer class="studio-footer wrap">
      <div class="footer-top"><a class="wordmark" href="/">OhWP<span>Studios</span></a><p>Thoughtfully made in Accra.<br />Built to work everywhere.</p></div>
      <div class="studio-footer-directory"><div><h3>Studio</h3><a href="/about">About</a><a href="/portfolio">Portfolio</a><a href="/case-studies">Case studies</a><a href="/clients">Clients</a><a href="/careers">Careers</a></div><div><h3>Tools &amp; guidance</h3><a href="/estimate-project">Project estimator</a><a href="/quiz">Project discovery quiz</a><a href="/website-analyzer">Website grader</a><a href="/website-audit">Website audit</a></div><div><h3>Explore</h3><a href="/sitemap-pages">Services &amp; solutions</a><a href="/blog">Blog &amp; insights</a><a href="/open-build">Open Build</a><a href={SITE_CONFIG.social.twitter} target="_blank" rel="noopener noreferrer">X / Twitter</a><a href={SITE_CONFIG.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={SITE_CONFIG.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href="https://github.com/ghwmelite-dotcom" target="_blank" rel="noopener noreferrer">GitHub</a></div><div><h3>Let’s work together</h3><a href="/contact">Contact</a><a href="/booking">Book a consultation</a><a href="/client/login">Client portal</a><a href={`mailto:${SITE_CONFIG.email}`}>Email us</a></div></div>
      <div class="studio-newsletter"><NewsletterSubscribe title="Notes from the studio" description="New builds, practical insights, and updates from OhWP Studios." /></div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} OhWP Studios. A Hodges &amp; Co. studio.</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div>
    </footer>
    <Chatbot />
    <ConsentBanner />
  </body>
</html>

<script>
  import '../scripts/studio-features';
</script>
